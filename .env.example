# AutoMT 个人配置（复制为 .env 使用；.env 已被 .gitignore 排除，绝不入库）
# 留空全部 = 使用内置免费谷歌端点，无需任何密钥

# 自定义翻译接口 URL 模板（{sl}=源语言 {tl}=目标语言 {q}=URL编码后的原文）
# 示例：
# MT_ENDPOINT=https://api.example.com/translate?source={sl}&target={tl}&text={q}
MT_ENDPOINT=

# API 密钥（可选）。默认以 Authorization: Bearer <key> 发送；
# 你的服务用别的头就改 MT_API_HEADER，例如 X-Api-Key（此时以原值发送）
MT_API_KEY=
MT_API_HEADER=Authorization

# 命令行模式（mt_translate.py）的语言设置；GUI 模式以界面下拉框为准
MT_SL=en
MT_TL=zh-CN
